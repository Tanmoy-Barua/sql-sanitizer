{
  "name": "sql-sanitizer",
  "version": "1.4.0",
  "description": "SQL injection request filter for Express/Fastify/Koa/Nest with presets, stats, CLI scanner, and parameterized sql helpers.",
  "main": "index.js",
  "module": "index.mjs",
  "types": "index.d.ts",
  "bin": {
    "sql-sanitizer": "bin/sql-sanitizer.js"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.mjs",
    "index.d.ts",
    "bin/",
    "lib/",
    "examples/",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "demo": "node demo-server.js",
    "scan": "node bin/sql-sanitizer.js scan .",
    "example:before-after": "node examples/before-after.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tanmoy-Barua/sql-sanitizer.git"
  },
  "keywords": [
    "sql",
    "sql-injection",
    "express",
    "fastify",
    "koa",
    "nestjs",
    "middleware",
    "security",
    "waf"
  ],
  "author": "Wahidul Alam, Tanmoy Barua, Shuva Mai Paul, Umma Zannath Rishad",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Tanmoy-Barua/sql-sanitizer/issues"
  },
  "homepage": "https://github.com/Tanmoy-Barua/sql-sanitizer#readme",
  "engines": {
    "node": ">=14"
  },
  "peerDependencies": {
    "express": ">=4"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "express": "^4.21.2"
  }
}
